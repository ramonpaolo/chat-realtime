<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070b13" />
  <meta name="description" content="Chat em tempo real, sem cadastro e sem histórico em banco. Crie uma sala, compartilhe o código e converse." />
  <meta property="og:title" content="Chat Realtime — salas efêmeras" />
  <meta property="og:description" content="Conversas em tempo real que não deixam rastros. Sem cadastro. Sem banco de dados." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/logo.svg" />

  <title>Chat Realtime — salas efêmeras</title>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css?v=2" />
</head>

<body class="landing-page">
  <%- include("partials/icons") %>

  <div class="page-bg" aria-hidden="true">
    <span class="orb orb-mint"></span>
    <span class="orb orb-violet"></span>
  </div>

  <header class="landing-header">
    <a class="brand" href="/" aria-label="Chat Realtime, início">
      <img src="/logo.svg" alt="" class="brand-mark" width="38" height="38" />
      <span class="brand-name">Chat Realtime</span>
      <span class="brand-tag">efêmero</span>
    </a>

    <nav class="landing-nav" aria-label="Navegação">
      <span class="nav-pill">
        <span class="live-dot"></span>
        sem cadastro
      </span>
      <a class="nav-link" href="https://github.com/ramonpaolo/chat-realtime" target="_blank" rel="noopener noreferrer">
        GitHub
        <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg>
      </a>
    </nav>
  </header>

  <main class="landing-main">
    <section class="hero" aria-labelledby="hero-title">
      <span class="eyebrow">
        <svg class="icon icon-xs"><use href="#icon-bolt"></use></svg>
        chat em tempo real · 100% em memória
      </span>

      <h1 id="hero-title" class="hero-title">
        Conversas que
        <span class="gradient-text">não deixam rastros.</span>
      </h1>

      <p class="hero-description">
        Crie uma sala, compartilhe o código e converse com quem estiver online.
        Sem conta, sem banco de dados e sem complicação.
      </p>

      <ul class="feature-list">
        <li class="feature">
          <span class="feature-icon"><svg class="icon"><use href="#icon-check"></use></svg></span>
          <div><strong>Sem cadastro</strong><span>Entre apenas com um nome.</span></div>
        </li>
        <li class="feature">
          <span class="feature-icon"><svg class="icon"><use href="#icon-bolt"></use></svg></span>
          <div><strong>Tempo real</strong><span>Mensagens na hora via Socket.io.</span></div>
        </li>
        <li class="feature">
          <span class="feature-icon"><svg class="icon"><use href="#icon-file"></use></svg></span>
          <div><strong>Arquivos e mídia</strong><span>Imagens, vídeos, PDFs e texto.</span></div>
        </li>
        <li class="feature">
          <span class="feature-icon"><svg class="icon"><use href="#icon-users"></use></svg></span>
          <div><strong>Efêmero de verdade</strong><span>Salas vazias expiram sozinhas.</span></div>
        </li>
      </ul>

      <p class="privacy-note">
        <svg class="icon icon-sm"><use href="#icon-lock"></use></svg>
        As mensagens não são gravadas em banco. O histórico vive apenas na memória do servidor.
      </p>
    </section>

    <section class="entry-card" aria-labelledby="entry-title">
      <div class="entry-card-glow" aria-hidden="true"></div>

      <div class="entry-head">
        <span class="entry-eyebrow" id="entry-eyebrow">Sala nova</span>
        <h2 id="entry-title">Crie sua sala</h2>
        <p id="entry-subtitle">Escolha um nome e comece a conversar.</p>
      </div>

      <div class="mode-switch" role="tablist" aria-label="Criar ou entrar em uma sala">
        <button type="button" class="mode-btn is-active" data-mode="create" role="tab" aria-selected="true">
          <svg class="icon icon-sm"><use href="#icon-plus"></use></svg>
          Criar sala
        </button>
        <button type="button" class="mode-btn" data-mode="join" role="tab" aria-selected="false">
          <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg>
          Entrar
        </button>
      </div>

      <form id="entry-form" novalidate>
        <label class="field">
          <span>Seu nome</span>
          <input id="name-input" name="name" type="text" maxlength="24" autocomplete="nickname" placeholder="Como podemos te chamar?" />
        </label>

        <label class="field is-hidden" id="code-field">
          <span>Código da sala</span>
          <input id="code-input" name="room" type="text" maxlength="64" autocomplete="off" spellcheck="false" placeholder="ex: 8f3a1c2b90" />
        </label>

        <p id="form-error" class="form-error is-hidden" role="alert"></p>

        <button type="submit" id="entry-submit" class="btn btn-primary btn-block">
          <span class="btn-label" id="entry-submit-label">Criar sala</span>
          <span class="btn-spinner is-hidden" aria-hidden="true"></span>
          <svg class="icon btn-arrow"><use href="#icon-arrow-right"></use></svg>
        </button>
      </form>

      <div class="entry-foot">
        <svg class="icon icon-xs"><use href="#icon-lock"></use></svg>
        Nada é salvo. Nada é rastreado.
      </div>
    </section>
  </main>

  <footer class="landing-footer">
    <p>
      <strong>Chat Realtime</strong>
      <span class="footer-sep">·</span>
      <a href="https://zenifra.com" target="_blank" rel="noopener noreferrer">Hospedado na Zenifra</a>
      <span class="footer-sep">·</span>
      <a href="https://github.com/ramonpaolo/chat-realtime" target="_blank" rel="noopener noreferrer">Código aberto</a>
    </p>
    <p class="footer-tech">Node.js · Socket.io · EJS</p>
  </footer>

  <script src="/js/landing.js?v=2" defer></script>
</body>

</html>
